# === ZK build artifacts ===
# Keep proving essentials small in git: commit final proving keys (*_final.zkey),
# the witness wasm (build/*_js/), and the tiny verifying keys (*_vkey.json + the
# generated programs/ayni/src/verifying_key*.rs). Ignore the multi-MB setup-only
# inputs, which are regenerable from circuits/ + a trusted-setup ceremony.
build/*.ptau
build/*_0.zkey
build/*.r1cs
build/*.sym

# F44 phase-2 ceremony working directory (zkey chains, transcript-in-progress,
# candidate VKs). Published ceremony artifacts are released deliberately, not
# committed from here. See docs/ceremony.md + scripts/ceremony/ (which must
# stay tracked — hence the root-anchored pattern).
/ceremony/

# graphify knowledge-graph cache (generated)
graphify-out/

# Windows alternate-data-stream junk (WSL)
*:Zone.Identifier

# Windows folder/file artifacts
desktop.ini
*:Zone.Identifier
*.Zone.Identifier

# === Mobile shells (F88/F89, Epic E12) ===
# The Capacitor android/ and ios/ scaffolds ARE committed (they carry their own
# .gitignore for generated/synced files). Ignore deps and build outputs only.
mobile/node_modules/
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/app/release/
mobile/android/local.properties
mobile/ios/App/Pods/
mobile/ios/App/build/
mobile/ios/App/output/
mobile/ios/App/App/public/
mobile/*.xcarchive
