# Caddy reverse proxy for the AHA · Ayni frontend.
#
# Serves the site over HTTPS on port 8443 for $DOMAIN (default aha.a13z.org),
# proxying to the Next.js container.
#
# This host's ports 80 and 443 are owned by another stack (the Odoo nginx),
# which also runs certbot. Rather than issue a certificate itself, Caddy uses
# the Let's Encrypt certificate that certbot obtains/renews for aha.a13z.org,
# mounted read-only from the shared certbot volume at /etc/letsencrypt.

{
	auto_https disable_redirects
}

{$DOMAIN:aha.a13z.org}:8443 {
	tls /etc/letsencrypt/live/aha.a13z.org/fullchain.pem /etc/letsencrypt/live/aha.a13z.org/privkey.pem
	reverse_proxy frontend:3000
}
